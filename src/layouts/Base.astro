---
// Shared frame for every Tercet Law page: head (meta, Ads tag + lead listener, structured data),
// header, footer, booking modal and page scripts. Content and settings live in src/data/site.js.
import '../styles/family.css';
import '../styles/tokens.css';
import '../styles/tercet.css';
import { firm, cta, nav, clientPortal, guideCta, plans, priceRange, booking, RESPONSIBLE_ATTORNEY } from '../data/site.js';

const {
  title = "Tercet Law | Estate, Trust & Legacy Planning in Austin, Texas",
  description = "Estate planning, probate, trust administration and elder law for Texas families. One complete plan and a flat fee in writing.",
  path = "/",
  inner = true,
  modal = true,
  sticky = true,
  image = "https://www.tercetlaw.com/og-tercet-texas.png",
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(path, firm.url).href;
const year = new Date().getFullYear();

const offers = plans.flatMap((p) => {
  if (p.amountCouple) {
    return [
      { "@type": "Offer", name: `${p.name} (one person)`, price: String(p.amount), priceCurrency: "USD" },
      { "@type": "Offer", name: `${p.name} (couple)`, price: String(p.amountCouple), priceCurrency: "USD" },
    ];
  }
  if (p.from) {
    return [{ "@type": "Offer", name: p.name, priceCurrency: "USD", priceSpecification: { "@type": "PriceSpecification", minPrice: p.amount, priceCurrency: "USD" } }];
  }
  return [{ "@type": "Offer", name: p.name, price: String(p.amount), priceCurrency: "USD" }];
});

const person = {
  "@type": "Person",
  "@id": `${firm.url}/#russ`,
  name: firm.attorney,
  jobTitle: "Attorney",
  worksFor: { "@id": `${firm.url}/#firm` },
  sameAs: [firm.linkedin],
};
if (RESPONSIBLE_ATTORNEY !== firm.attorney) person.alternateName = RESPONSIBLE_ATTORNEY;
if (firm.barNumber) person.identifier = { "@type": "PropertyValue", propertyID: "State Bar of Texas", value: firm.barNumber };

const firmSchema = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "@id": `${firm.url}/#firm`,
  name: firm.name,
  legalName: firm.legalName,
  url: firm.url,
  telephone: firm.phoneSchema,
  email: firm.email,
  image: "https://www.tercetlaw.com/og-tercet-texas.png",
  description: "Estate planning, probate and estate administration, trust administration, elder law and incapacity planning, special needs planning, business succession and Texas deeds for Texas families. Flat fees in writing. Every matter handled personally by the attorney. Free 45-minute Estate Map Session on Zoom.",
  address: { "@type": "PostalAddress", ...(firm.street ? { streetAddress: firm.street, postalCode: firm.zip } : {}), addressLocality: "Austin", addressRegion: "TX", addressCountry: "US" },
  areaServed: [
    { "@type": "City", name: "Austin", containedInPlace: { "@type": "State", name: "Texas" } },
    { "@type": "AdministrativeArea", name: "Travis County, Texas" },
    { "@type": "State", name: "Texas" },
  ],
  knowsAbout: ["Estate planning", "Wills", "Revocable living trusts", "Powers of attorney", "Texas probate", "Trust administration", "Elder law", "Guardianship alternatives", "Special needs planning", "Business succession", "Transfer on death deeds", "Texas homestead"],
  priceRange,
  founder: person,
  hasOfferCatalog: { "@type": "OfferCatalog", name: "Flat-fee estate plans", itemListElement: offers },
};
const ld = [firmSchema, ...schema];
---
<!doctype html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="Tercet Law" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={image} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:url" content={canonical} /><meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={image} />
  <meta name="geo.region" content="US-TX" /><meta name="geo.placename" content="Austin" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- Google Ads gtag (AW-18371546487) + conversion listeners: Calendly booking and HubSpot form -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script>
    window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};var gtag=window.gtag;
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD',{linker:{domains:['vaulthuman.com','tercetlaw.com']}});
    (function(){var fired=false;function fire(){if(fired)return;fired=true;gtag('event','conversion',{send_to:'AW-18371546487/yVNiCKX9xqkdEPeanrhE'});gtag('event','generate_lead');}
    window.addEventListener('message',function(e){var d=e&&e.data;if(!d)return;if(typeof d==='string'){try{d=JSON.parse(d);}catch(_){return;}}if(!d||typeof d!=='object')return;var t=d.type||d.messageType||'',n=d.eventName||d.event||'';if(t==='hsFormCallback'&&(n==='onFormSubmitted'||n==='onFormSubmit'))fire();else if(n==='onFormSubmitted')fire();else if(d.accepted===true&&d.formGuid)fire();});
    window.addEventListener('hsFormCallback',function(e){if(e&&e.detail&&e.detail.eventName==='onFormSubmitted')fire();});
    window.addEventListener('message',function(e){if(!/(^|\.)calendly\.com$/.test((e.origin||'').replace(/^https?:\/\//,'')))return;var d=e.data;if(d&&d.event==='calendly.event_scheduled'){fire();gtag('event','book_appointment');}});})();
  </script>
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body data-time="future" class={inner ? 'inner' : undefined}>
  <header class="site"><div class="wrap bar">
    <a class="brand" href="/">Tercet <b>Law</b></a>
    <nav class="navlinks" id="navlinks" aria-label="Main">{nav.map((n) => <a href={n.href} aria-current={(path === n.href + '/' || path === n.href) ? 'page' : undefined}>{n.label}</a>)}<a class="navutil navphone" href={firm.phoneHref}><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>{firm.phone}</a><a class="navutil" href={clientPortal.href}><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 11h12v9H6zM8.5 11V8a3.5 3.5 0 0 1 7 0v3"/></svg>{clientPortal.label}</a><a class="btn btn-acc" href={cta.href} aria-label={cta.label}>{cta.short}</a></nav><a class="hdrcall" href={firm.phoneHref} aria-label={`Call ${firm.phone}`}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></a><button class="navtoggle" type="button" aria-label="Open menu" aria-controls="navlinks" aria-expanded="false"><span></span><span></span><span></span></button>
  </div></header>

  <main><slot /></main>

  <footer class="site">
    <div class="wrap foot">
      <div><a class="brand" href="/">Tercet <b>Law</b></a><p>Estate planning for Texas families. Flat fees, in writing.</p><p><a href={`mailto:${firm.email}`}>{firm.email}</a> · <a href={firm.phoneHref}>{firm.phone}</a></p></div>
      <ul><li><a href="/about">About Russ</a></li><li><a href="/services">Services</a></li><li><a href="/pricing">Pricing</a></li><li><a href="/process">Process</a></li><li><a href="/faq">Texas FAQ</a></li><li><a href="/writing/">Writing</a></li><li><a href={cta.href}>{cta.label}</a></li></ul>
      <ul><li><a href={guideCta.href}>Free Texas checklist</a></li><li><a href={clientPortal.href}>{clientPortal.label}</a></li><li><a href="/disclaimers">Disclaimers</a></li><li><a href="/privacy/">Privacy</a></li><li><a href={firm.linkedin} target="_blank" rel="noopener">LinkedIn</a></li></ul>
    </div>
    <div class="wrap legal"><span class="resp">{firm.legalName} · {firm.street ? `${firm.street}, ` : ''}{firm.city}, {firm.state}{firm.zip ? ` ${firm.zip}` : ''} · Responsible attorney: {RESPONSIBLE_ATTORNEY}{firm.barNumber ? `, State Bar of Texas No. ${firm.barNumber}` : ''}</span><span>Attorney advertising</span></div>
    <div class="wrap legal-fine">&copy; {year} {firm.legalName}. {firm.license}. This website is general information, not legal advice. No attorney-client relationship forms until an engagement letter is signed. <a href="/disclaimers">Disclaimers</a> · <a href="/privacy/">Privacy</a></div>
  </footer>

  {modal && (
  <div id="vpop" class="vpop" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Video">
    <button class="vpop__x" type="button" data-vpop-close aria-label="Close video">&times;</button>
    <video controls playsinline preload="none"></video>
  </div>
  <div id="vh-modal" class="vh-modal" aria-hidden="true">
    <div class="vh-modal__bg" data-close-form></div>
    <div class="vh-modal__card" role="dialog" aria-modal="true" aria-label="Book your Estate Map Session">
      <button class="vh-modal__x" type="button" data-close-form aria-label="Close">&times;</button>
      <h2 class="vh-modal__title">Book your Estate Map Session</h2><p class="vh-modal__sub">Free, 45 minutes, on Zoom. Pick a time that suits you and you'll get a calendar invite with the link.</p>
      <div class="calendly-inline-widget" data-url={booking.embed} style="min-width:300px;height:640px;border-radius:10px;overflow:hidden;background:#fff"></div><p style="margin:12px 0 0;font-size:14px;opacity:.8;text-align:center">Rather talk now? <a href={firm.phoneHref}>{firm.phone}</a></p><script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script><style is:inline>.vh-modal__card{width:min(820px,94vw)!important}</style>
    </div>
  </div>
  )}
  <script is:inline>
  (function(){
  function ga(t){try{gtag('event','video_start',{video_title:t})}catch(e){}}
  function prep(box){if(box._v)return box._v;var v=document.createElement('video');v.controls=false;v.disablePictureInPicture=true;v.setAttribute('controlslist','nodownload nofullscreen noremoteplayback');v.disableRemotePlayback=true;v.setAttribute('x-webkit-airplay','deny');['play','playing','pause','loadedmetadata'].forEach(function(ev){v.addEventListener(ev,function(){if(v.controls||v.hasAttribute('controls')){v.controls=false;v.removeAttribute('controls')}})});v.playsInline=true;v.setAttribute('playsinline','');v.setAttribute('webkit-playsinline','');v.preload='metadata';v.poster=box.dataset.poster||'';v.src=box.dataset.src;
    if(box.dataset.captions){var t=document.createElement('track');t.kind='captions';t.srclang='en';t.label='English';t.src=box.dataset.captions;t.default=true;v.appendChild(t)}
    v.addEventListener('playing',function(){box.classList.remove('loading','paused');box.classList.add('playing')});
    v.addEventListener('pause',function(){if(box.classList.contains('playing'))box.classList.add('paused')});
    v.addEventListener('ended',function(){box.classList.add('paused');v.currentTime=0});
    var bar=document.createElement('div');bar.className='vslot__bar';var fill=document.createElement('i');bar.appendChild(fill);
    v.addEventListener('timeupdate',function(){if(v.duration)fill.style.width=(100*v.currentTime/v.duration)+'%'});
    bar.addEventListener('click',function(e){e.stopPropagation();var r=bar.getBoundingClientRect();if(v.duration)v.currentTime=v.duration*Math.min(1,Math.max(0,(e.clientX-r.left)/r.width))});
    box.appendChild(v);box.appendChild(bar);box._v=v;return v}
  function play(box){var v=prep(box);if(box.classList.contains('playing')){if(v.paused){v.play()}else{v.pause()}return}v.preload='auto';box.classList.add('loading');
    document.querySelectorAll('[data-vslot-box] video').forEach(function(o){if(o!==v)o.pause()});
    var q=v.play();if(q&&q.catch)q.catch(function(){box.classList.remove('loading');box.classList.add('playing')});ga(box.querySelector('.vslot__play').getAttribute('aria-label'))}
  var boxes=[].slice.call(document.querySelectorAll('[data-vslot-box]'));
  boxes.forEach(function(box){box.addEventListener('click',function(){play(box)});box.addEventListener('pointerdown',function(){prep(box)},{passive:true})});
  if('IntersectionObserver'in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){prep(e.target);io.unobserve(e.target)}})},{rootMargin:'300px 0px'});boxes.forEach(function(b){io.observe(b)})}
  var p=document.getElementById('vpop'),pv=p&&p.querySelector('video');
  function close(){pv.pause();p.classList.remove('open');p.setAttribute('aria-hidden','true');document.body.style.overflow=''}
  document.querySelectorAll('[data-vslot]').forEach(function(b){b.addEventListener('click',function(){
    var box=boxes.filter(function(x){return x.dataset.src===b.dataset.vslot})[0];
    if(box){box.scrollIntoView({behavior:'smooth',block:'center'});play(box);return}
    if(!p)return;pv.innerHTML='';pv.src=b.dataset.vslot;pv.poster=b.dataset.vslotPoster||'';pv.preload='auto';
    if(b.dataset.vslotCaptions){var t=document.createElement('track');t.kind='captions';t.srclang='en';t.label='English';t.src=b.dataset.vslotCaptions;t.default=true;pv.appendChild(t)}
    p.classList.add('open');p.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';var q=pv.play();if(q&&q.catch)q.catch(function(){});ga(b.textContent)})});
  if(p){p.querySelectorAll('[data-vpop-close]').forEach(function(x){x.addEventListener('click',close)});
  p.addEventListener('click',function(e){if(e.target===p)close()});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&p.classList.contains('open'))close()});}})();
  </script>
  <script is:inline src="https://js-na2.hsforms.net/forms/embed/246947446.js" defer></script>
  <script is:inline>
  (function(){var m=document.getElementById('vh-modal');if(!m)return;
  function o(e){if(e)e.preventDefault();m.classList.add('is-open');m.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';}
  function c(){m.classList.remove('is-open');m.setAttribute('aria-hidden','true');document.documentElement.style.overflow='';}
  document.addEventListener('click',function(e){var t=e.target.closest('[data-open-form]');if(t){o(e);return;}if(e.target.closest('[data-close-form]'))c();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')c();});
  if(location.hash==='#start')o();})();
  addEventListener('DOMContentLoaded',function(){
   document.body.classList.add('ready');
   if(!('IntersectionObserver'in window))return;
   var e=[].slice.call(document.querySelectorAll('.sec .wrap > *, .split__copy > *'));e.forEach(function(x){x.classList.add('reveal')});
   var o=new IntersectionObserver(function(t){t.forEach(function(y){if(y.isIntersecting){y.target.classList.add('in');o.unobserve(y.target)}})},{threshold:0.08,rootMargin:'0px 0px -30px 0px'});
   e.forEach(function(x){o.observe(x)});
  });
  </script>
  {sticky && (<div class="stickybar" id="stickybar"><span>Tercet Law</span><a class="btn btn-acc" href={cta.href}>{cta.label}</a></div>)}
  <script is:inline>
  (function(){var sb=document.getElementById('stickybar');if(!sb)return;document.body.classList.add('has-sticky');
  // Show the bar only once you have scrolled, and never while another set of buttons is on screen (no stacked buttons).
  var rows=[].slice.call(document.querySelectorAll('.ctarow')),vis=new Set();
  function f(){sb.classList.toggle('on',scrollY>240&&vis.size===0)}
  if('IntersectionObserver'in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){e.isIntersecting?vis.add(e.target):vis.delete(e.target)});f()});rows.forEach(function(r){io.observe(r)})}
  addEventListener('scroll',f,{passive:true});f();})();
  </script>
  <script is:inline>(function(){var b=document.querySelector(".navtoggle"),n=document.getElementById("navlinks");if(!b||!n)return;function set(o){document.body.classList.toggle("nav-open",o);b.setAttribute("aria-expanded",o?"true":"false");b.setAttribute("aria-label",o?"Close menu":"Open menu");}b.addEventListener("click",function(){set(!document.body.classList.contains("nav-open"));});n.addEventListener("click",function(e){if(e.target.closest("a"))set(false);});document.addEventListener("keydown",function(e){if(e.key==="Escape")set(false);});})();</script>
  <script is:inline>(function(){var h=document.querySelector("header.site");function f(){if(h)h.classList.toggle("scrolled",scrollY>40)}addEventListener("scroll",f,{passive:true});f();})();</script>
</body>
</html>
