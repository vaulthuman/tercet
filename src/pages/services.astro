---
import Base from '../layouts/Base.astro';
import { practiceAreas } from '../data/site.js';
---
<Base title="Services — Tercet Law" description="Estate planning, trusts, probate, powers of attorney, elder law, guardianship, and business succession for families.">
  <div class="wrap">
    <div class="pagehead">
      <p class="eyebrow">Areas of practice</p>
      <h1>Everything a family needs, in one plan.</h1>
      <p class="dek">The people, the property, and the wishes that bind them &mdash; drafted as one plan, not three loose documents.</p>
    </div>
    <hr class="rule" />
    <section class="areas">{practiceAreas.map((a) => (<div class="area"><h4>{a.name}</h4><p>{a.blurb}</p></div>))}</section>
    <hr class="rule" />
    <div class="ctarow"><a class="btn-fill" href="/start">Start with a conversation</a></div>
  </div>
</Base>
