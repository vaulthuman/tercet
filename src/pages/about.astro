---
import Base from '../layouts/Base.astro';
import Tercet from '../components/Tercet.astro';
import { firm, cta } from '../data/site.js';
---
<Base
  title="About Russ Michaels | Tercet Law, Austin"
  description="Russ Michaels is an Austin attorney who handles every Tercet Law estate plan personally, with more than twenty years as a CEO and nonprofit leader. Flat fees, plain English."
  path="/about/"
>
    <section class="pagehero photo-right"><img class="bgimg" src="/images/about-letter-coffee.jpg" width="1800" height="1200" style="object-position:38% 50%" alt="Someone writing a letter by hand at a wooden table, a cup of coffee beside the page" fetchpriority="high" /><div class="veil"></div><div class="wrap">
      <p class="eyebrow">About Russ</p><h1>One attorney. <em>Every plan, personally.</em></h1><p class="lede">Not a case number at a large firm. {firm.attorney} handles every Tercet Law matter himself, from the first map to the final signature.</p><div class="ctarow" style="margin-top:28px"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href={firm.phoneHref}>{firm.phone}</a></div>
    </div></section>

    <section class="sec" id="russ"><div class="wrap about-grid">
      <img src="/russ-michaels.jpg" alt="Russ Michaels, attorney and founder of Tercet Law" loading="lazy" />
      <div><p class="eyebrow">Your attorney</p><h2>Russ Michaels</h2>
        <div class="prose" style="margin-top:20px">
        <p>Russ Michaels is an attorney based in Austin, Texas, and the founder of Tercet Law. He handles every matter personally: the Estate Map Session, the design, the drafting and the signing, and the guidance families need after a loss.</p>
        <p>Most people he meets have meant to plan for years. He understands why it gets put off, and he works to make it simple: a clear map, plain-English documents, and a fee in writing before any work begins.</p>
        <p>Alongside the law, Russ has spent more than twenty years as a CEO and nonprofit leader, serving as a chief executive, an executive director and a board president. That work shaped how he plans: a document is only as good as how it holds up on the day it is needed.</p>
        <p>{firm.license}. Planning meetings are on Zoom; signings are arranged where it is convenient for you.</p>
        </div>
        <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href={firm.linkedin} target="_blank" rel="noopener">LinkedIn</a></div>
      </div>
    </div></section>

    <Tercet variant="lines" alt />

    <section class="split" id="how"><div class="split__media" style="background-image:url('https://images.unsplash.com/photo-1450101499163-c8848c66ca85?w=1400&q=72&auto=format&fit=crop')" role="img" aria-label="Signing a document"></div><div class="split__copy">
      <p class="eyebrow">How Russ works</p><h2>Careful documents. Clear answers. No pressure.</h2>
      <ul class="ticks"><li>He recommends the plan that fits, not the biggest one.</li><li>You read every page before you sign.</li><li>You get clear instructions to fund your trust, so it holds what it is meant to hold.</li><li>He is here when life changes.</li></ul>
      <div class="ctarow"><a class="btn btn-acc" href="/process">How it works</a><a class="btn btn-line" href="/pricing">Plans &amp; pricing</a></div>
    </div></section>

    <section class="sec final plain" id="begin"><div class="wrap">
      <h2>Meet Russ on Zoom.</h2><p class="lede">A free 45-minute Estate Map Session. You leave knowing what you need and exactly what it costs.</p>
      <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href={firm.phoneHref}>{firm.phone}</a></div>
    </div></section>
</Base>
