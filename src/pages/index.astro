<style is:global>
  :root{
    --ivory:#F7F3EA;      /* warm base */
    --ivory-2:#EFE9DC;    /* card / alt band */
    --ink:#1C1B18;        /* near-black text */
    --ink-soft:#4A4740;   /* secondary text */
    --forest:#20463A;     /* primary accent (trust/legacy) */
    --forest-deep:#163127;
    --brass:#A9843E;      /* warm accent */
    --line:#DED6C6;
    --white:#FFFFFF;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:'Inter',system-ui,sans-serif;color:var(--ink);background:var(--ivory);line-height:1.6;-webkit-font-smoothing:antialiased}
  h1,h2,h3,h4{font-family:'Fraunces',Georgia,serif;font-weight:500;line-height:1.12;letter-spacing:-0.01em}
  h1{font-size:clamp(2.3rem,5vw,4rem)}
  h2{font-size:clamp(1.8rem,3.5vw,2.7rem)}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1160px;margin:0 auto;padding:0 26px}
  .btn{display:inline-block;padding:15px 30px;border-radius:2px;font-weight:600;font-size:.95rem;letter-spacing:.02em;cursor:pointer;border:1.5px solid transparent;transition:.18s;text-align:center}
  .btn-primary{background:var(--forest);color:var(--ivory)}
  .btn-primary:hover{background:var(--forest-deep)}
  .btn-ghost{background:transparent;color:var(--ink);border-color:var(--ink)}
  .btn-ghost:hover{background:var(--ink);color:var(--ivory)}
  .eyebrow{font-family:'Inter';font-weight:600;letter-spacing:.18em;text-transform:uppercase;font-size:.72rem;color:var(--brass)}

  /* utility bar */
  .util{background:var(--forest-deep);color:#E9E2D3;font-size:.8rem;letter-spacing:.04em;text-align:center;padding:8px 14px}
  .util b{color:var(--white);font-weight:600}

  /* header */
  header{position:sticky;top:0;z-index:50;background:rgba(247,243,234,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:72px}
  .brand{font-family:'Fraunces';font-size:1.5rem;font-weight:600;letter-spacing:.16em}
  .brand small{display:block;font-family:'Inter';font-size:.58rem;letter-spacing:.34em;color:var(--ink-soft);font-weight:600;margin-top:-2px}
  .navlinks{display:flex;gap:30px;align-items:center}
