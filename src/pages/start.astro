---
import Base from '../layouts/Base.astro';
import VideoSlot from '../components/VideoSlot.astro';
import { firm, cta, priceSummary, booking, pricesEffectiveThrough } from '../data/site.js';
---
<Base
  title="Book your Estate Map Session | Tercet Law, Austin"
  description="Book a free 45-minute Estate Map Session on Zoom with Austin attorney Russ Michaels. See your whole estate on one screen and leave knowing which flat-fee plan fits."
  path="/start/"
  modal={false}
  sticky={false}
>
    <section class="pagehero"><img class="bgimg" src="/video/start.jpg" width="1280" height="720" style="object-position:50% 50%" alt="Three generations of a family sharing a meal around a dinner table" fetchpriority="high" /><video class="bgimg bgvid" autoplay muted loop playsinline preload="auto" poster="/video/start.jpg" style="object-position:50% 50%" aria-hidden="true"><source src="/video/start.mp4" type="video/mp4" /></video><div class="veil"></div><div class="wrap">
      <p class="eyebrow">Free · 45 minutes · Zoom</p><h1>Book your <em>Estate Map Session.</em></h1><p class="lede">Forty-five minutes on Zoom with {firm.attorney}. You see your whole estate on one screen, and you leave knowing which plan fits and its exact flat fee. No cost, no obligation.</p><div class="ctarow" style="margin-top:28px"><a class="btn btn-acc" href="#book">Pick a time</a><a class="btn btn-line" href={firm.phoneHref}>Call {firm.phone}</a></div>
    </div></section>

    <!-- Swap in a session video when it is finished. -->
    <VideoSlot title="Meet Russ Michaels" eyebrow="Your attorney" heading="Meet Russ before you book." lede="Forty-five minutes on Zoom. Nothing to send ahead of time. You leave knowing what fits and its flat fee." />

    <section class="sec" id="book"><div class="wrap start-grid">
      <div><p class="eyebrow">What happens next</p><h2>Three steps.</h2>
        <div class="steps" style="grid-template-columns:1fr;margin-top:28px"><div class="step"><div class="n">01</div><h3>Pick a time</h3><p>Choose a time that suits you. You get a calendar invite with the link. Russ reads every booking himself.</p></div><div class="step"><div class="n">02</div><h3>Your Estate Map Session</h3><p>Forty-five minutes on Zoom. Russ maps what you own, who depends on you and who you trust, on one screen you can see. A rough picture is enough.</p></div><div class="step"><div class="n">03</div><h3>A flat fee in writing</h3><p>You get a recommendation and a fixed fee. You decide. If it is a yes, the work starts right away.</p></div></div>
        <p class="offers-note" style="margin-top:22px">Flat-fee plans: {priceSummary} (effective through {pricesEffectiveThrough}). <a href="/pricing">See what is in each plan</a>.</p>
      </div>
      <div class="formcard"><h3>Pick a time</h3><p>Confidential. Please share only a short note about what you need; details can wait for the session.</p>
        <div class="calendly-inline-widget" data-url={booking.embed} style="min-width:300px;height:640px;border-radius:10px;overflow:hidden;background:#fff"></div><p style="margin:12px 0 0;font-size:14px;opacity:.8;text-align:center">Rather talk now? <a href={firm.phoneHref}>{firm.phone}</a></p><script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script><style is:inline>.vh-modal__card{width:min(820px,94vw)!important}</style>
      </div>
    </div></section>
    <section class="split"><div class="split__media" style="background-image:url('/images/start-family-kitchen.jpg');background-position:50% 30%" role="img" aria-label="A mother, father and their two children smiling together at the kitchen counter"></div><div class="split__copy">
      <p class="eyebrow">Why families book</p><h2>Forty-five minutes now. Clarity for years.</h2>
      <p class="split__lede">You leave knowing which plan fits your family and the flat fee for it, in writing. No cost, no obligation, and no pressure either way.</p>
      <div class="ctarow"><a class="btn btn-acc" href="#book">Pick a time</a></div>
    </div></section>

    <section class="sec alt" id="who"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Who you will meet</p><h2 style="color:var(--ink)">Russ Michaels</h2><p class="lede">An attorney in Austin with more than twenty years as a CEO and nonprofit leader. You work directly with him, on a flat fee, from the first map to the signing.</p><p class="offers-note" style="margin-top:6px">{firm.license}. Booking a session does not create an attorney-client relationship; that begins only when an engagement letter is signed. <a href="/about">About Russ</a>.</p></div>
    </div></section>
</Base>
