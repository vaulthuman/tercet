---
import '../styles/global.css';
import { firm } from '../data/site.js';
const { title = "Tercet Law — Estate, Trust & Legacy Planning", description = "Tercet Law — estate, trust, and legacy planning for families. Flat fees, plans built to hold." } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <!-- Google Ads gtag (AW-18371546487) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
    gtag('js',new Date());gtag('config','AW-18371546487');
    window.addEventListener('message',function(e){if(e&&e.data&&e.data.type==='hsFormCallback'&&e.data.eventName==='onFormSubmitted'){gtag('event','conversion',{send_to:'AW-18371546487/r4eECOKGw9wcEPeanrhE'});gtag('event','generate_lead');}});
  </script>
</head>
<body>
  <header class="site">
    <div class="wrap bar">
      <a class="brand" href="/">{firm.name}</a>
      <nav class="navlinks">
        <a href="/services">Services</a>
        <a href="/process">Process</a>
        <a href="/pricing">Pricing</a>
        <a href="/about">About</a>
        <a class="navbtn" href="/start">Book a conversation</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site">
    <div class="wrap">
      <p class="disc">{firm.legalName}. Russ Michael Schmidtberger (&ldquo;Russ Michaels&rdquo;) is the attorney responsible for this communication and is licensed to practice law in Alabama. This website is attorney advertising, offered for general information and not as legal advice; an attorney&ndash;client relationship begins only upon a signed engagement agreement. <a href="/disclaimers" style="text-decoration:underline">Full disclaimers</a>.</p>
      <p class="sig">{firm.legalName.toUpperCase()}</p>
      <p class="meta">&copy; {year} {firm.legalName}. All&nbsp;rights&nbsp;reserved. &middot; {firm.attorneyDisplay}, Esq. &middot; <a href={`mailto:${firm.email}`}>{firm.email}</a></p>
      <p class="backlink">A member of the <a href="https://www.vaulthuman.com">Vault Human</a> family of companies.</p>
    </div>
  </footer>
<script>
addEventListener('DOMContentLoaded',function(){
 if(!('IntersectionObserver'in window))return;
 var s='main .wrap>section:not(.hero),main .wrap>h2,main .wrap>.prose,main .wrap>.lede,main .wrap>.cta,main .wrap>.ctarow,main .wrap>.turn,main .wrap>.closing,main .wrap>.why,main .wrap>.tags,main .wrap>.markets,main .wrap>.pkgs,main .wrap>.areas,main .wrap>.steps,main .wrap>.cols,main .wrap>.pagehead';
 var e=[].slice.call(document.querySelectorAll(s));
 e.forEach(function(x){x.classList.add('reveal')});
 var o=new IntersectionObserver(function(t){t.forEach(function(y){if(y.isIntersecting){y.target.classList.add('in');o.unobserve(y.target)}})},{threshold:0.06,rootMargin:'0px 0px -30px 0px'});
 e.forEach(function(x){o.observe(x)});
});
</script>

</body>
</html>
