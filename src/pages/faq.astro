---
import Base from '../layouts/Base.astro';
import { firm, cta, faqs, faqDisclaimer, priceSummary } from '../data/site.js';

const cost = {
  id: 'cost',
  q: 'How much does an estate plan cost at Tercet Law?',
  a: [
    `Every plan is a flat fee set in writing before any work begins: ${priceSummary}. The Estate Map Session is free.`,
  ],
};
const all = [...faqs, cost];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: all.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a.join(' ') } })),
};
---
<Base
  title="Texas Estate Planning FAQ | Tercet Law, Austin"
  description="Plain answers on wills and living trusts in Texas, probate, the homestead, community property, powers of attorney and what to bring to your Estate Map Session. General information, not legal advice."
  path="/faq/"
  schema={[faqSchema]}
>
    <section class="pagehero photo-right"><img class="bgimg" src="/images/faq-law-book.jpg" width="1800" height="1202" style="object-position:55% 45%" alt="A hand resting on a law book on a wooden desk" fetchpriority="high" /><div class="veil"></div><div class="wrap">
      <p class="eyebrow">Texas FAQ</p><h1>Texas estate planning, <em>in plain English.</em></h1><p class="lede">Short answers to the questions Austin families ask most. General information only; your Estate Map Session is where it gets specific to you.</p><div class="ctarow" style="margin-top:28px"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href="#questions">Read the answers</a></div>
    </div></section>

    <section class="sec" id="questions"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Questions</p><h2>Straight answers.</h2></div>
      <div class="faq">{all.map((f, i) => (<details id={f.id} open={i === 0}><summary>{f.q}</summary>{f.a.map((p) => <p>{p}</p>)}</details>))}</div>
      <p class="faq-note"><b>{faqDisclaimer}</b> For advice about your own situation, book an Estate Map Session or call {firm.phone}.</p>
    </div></section>

    <section class="sec final plain" id="begin"><div class="wrap">
      <h2>Ask about your own estate.</h2><p class="lede">A free 45-minute Estate Map Session on Zoom. You see your whole estate on one screen and leave knowing what you need.</p>
      <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href={firm.phoneHref}>{firm.phone}</a></div>
    </div></section>
</Base>
