---
import Base from '../layouts/Base.astro';
import Plans from '../components/Plans.astro';
import EstateMap from '../components/EstateMap.astro';
import { firm, cta, steps, timingNote, faqs, trustPriceNote } from '../data/site.js';
const homeFaqs = faqs.filter((f) => ['will-or-trust', 'probate', 'homestead', 'bring'].includes(f.id));
---
<Base
  title="Tercet Law | Flat-Fee Estate Planning in Austin, Texas"
  description="Flat-fee wills, trusts and powers of attorney for Austin families and business owners. Every plan handled personally by attorney Russ Michaels. Book a free 45-minute Estate Map Session on Zoom."
  path="/"
  inner={false}
>
    <section class="hero"><img class="bgimg" src="https://images.unsplash.com/photo-1714974528737-3e6c7e4d11af?w=1800&q=72&auto=format&fit=crop" alt="An attorney meeting with clients across a small table" fetchpriority="high" /><div class="veil"></div>
      <div class="wrap"><div class="hero-copy">
        <div class="timeword"><span class="tw past">Past</span><span class="tw present">Present</span><span class="tw future on">Future</span></div>
        <h1>Estate planning for Austin families. <em>One flat fee.</em></h1>
        <p class="lede">Wills, trusts and powers of attorney for Austin families and business owners. {firm.attorney} handles every plan personally, and your fee is set in writing before any work begins.</p>
        <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href="/pricing">See plans &amp; pricing</a></div>
        <p class="guarantee">Free · 45 minutes · on Zoom · {firm.license}</p>
      </div></div>
    </section>

    <section class="sec alt" id="map"><div class="wrap mapgrid">
      <div>
        <p class="eyebrow">The Estate Map Session</p>
        <h2>See your whole estate on one screen.</h2>
        <ul class="ticks">
          <li>Forty-five minutes on Zoom with {firm.attorney}, free.</li>
          <li>Russ builds a visual map as you talk: what you own, who depends on you, and who you trust to take charge.</li>
          <li>You see how each piece would pass today, and where the gaps are.</li>
          <li>You leave knowing which plan fits and its exact flat fee. No pressure either way.</li>
        </ul>
        <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a></div>
      </div>
      <EstateMap />
    </div></section>

    <section class="split" id="problem"><div class="split__media" style="background-image:url('https://images.unsplash.com/photo-1758227365187-016878604d94?w=1400&q=72&auto=format&fit=crop');background-position:center" role="img" aria-label="A small wooden house, a family and a key on a table"></div><div class="split__copy">
      <p class="eyebrow">Why plan now</p><h2>Without a plan, Texas law makes the choices.</h2>
      <ul class="ticks"><li>Without a will, Texas law decides who inherits and a court decides who is in charge.</li><li>If you cannot act for yourself, your family may need a court's permission to act for you.</li><li>A trust that was never funded protects nothing.</li><li>Powers of attorney and a directive to physicians keep decisions with the people you chose.</li></ul>
      <div class="ctarow"><a class="btn btn-line" href="/faq">Read the Texas FAQ</a></div>
    </div></section>

    <section class="sec" id="who"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Who we help</p><h2>Austin families and business owners.</h2></div>
      <div class="pcards"><div class="pcard"><img src="https://images.unsplash.com/photo-1681505504714-4ded1bc247e7?w=900&q=72&auto=format&fit=crop" alt="Reviewing and signing estate documents across a desk" loading="lazy" /><span class="pc-k">Families</span><b>Parents with children at home</b><em>Name a guardian, decide who manages what your children inherit, and keep decisions with people you trust.</em></div><div class="pcard"><img src="https://images.unsplash.com/photo-1570129477492-45c003edd2be?w=900&q=72&auto=format&fit=crop" alt="A family home with a wide front porch" loading="lazy" /><span class="pc-k">Homeowners</span><b>Couples and homeowners</b><em>Plan for your Texas home and accounts, with a trust where it fits, so your family is not left to sort it out in court.</em></div><div class="pcard"><img src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=900&q=72&auto=format&fit=crop" alt="A handshake across a desk" loading="lazy" /><span class="pc-k">Owners</span><b>Business owners</b><em>Fit your company into the same plan as your family, in coordination with your CPA and financial advisor.</em></div></div>
    </div></section>

    <section class="sec alt" id="pricing"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Plans &amp; pricing</p><h2>Four plans. Flat fees.</h2><p class="lede">Your fee is set in writing before any work begins. No hourly billing on your plan.</p></div>
      <Plans detail={false} />
      <p class="offers-note">{trustPriceNote} Legacy is quoted in writing after your Estate Map Session. <a href="/pricing">See everything each plan includes</a>.</p>
    </div></section>

    <section class="sec" id="how"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">How it works</p><h2>Map. Design. Sign. Fund.</h2><p class="lede">A signed plan in about three weeks from the day you engage.</p></div>
      <div class="steps four">{steps.map((s) => (<div class="step"><div class="n">{s.n}</div><p class="when">{s.when}</p><h3>{s.title}</h3><p>{s.body}</p></div>))}</div>
      <p class="offers-note">{timingNote}</p>
      <div class="ctarow" style="margin-top:22px"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href="/process">How it works</a></div>
    </div></section>

    <section class="sec dark" id="russ"><div class="wrap guide-grid">
      <img src="/russ-michaels.jpg" alt="Russ Michaels, attorney" width="340" height="425" loading="lazy" />
      <div><p class="eyebrow">Your attorney</p><h2>Russ Michaels</h2><p class="lede">An attorney in Austin who handles every plan personally, from the first map to the final signature. More than twenty years as a CEO and nonprofit leader taught him what a plan has to do when it is finally needed.</p><blockquote>A good plan is not about the end. It is about the people you love knowing exactly what you intended.</blockquote><div class="ctarow"><a class="btn btn-ghost" href="/about">About Russ</a><a class="btn btn-ghost" href={firm.linkedin} target="_blank" rel="noopener">LinkedIn</a></div></div>
    </div></section>

    <section class="sec alt" id="faq"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Texas questions</p><h2>Straight answers.</h2></div>
      <div class="faq">{homeFaqs.map((f) => (<details><summary>{f.q}</summary>{f.a.map((p) => <p>{p}</p>)}</details>))}</div>
      <p class="offers-note">General information, not legal advice. <a href="/faq">More Texas questions</a>.</p>
    </div></section>

    <section class="sec final" id="begin"><img class="bgimg" src="https://images.unsplash.com/photo-1761233976686-f43410a4f5d8?w=1800&q=72&auto=format&fit=crop" alt="Four generations of hands resting together on a table" loading="lazy" /><div class="veil"></div><div class="wrap">
      <h2>See your estate on one screen.</h2><p class="lede">Forty-five minutes on Zoom, free. You leave knowing what you need and exactly what it costs.</p>
      <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href={firm.phoneHref}>{firm.phone}</a></div>
    </div></section>
</Base>
