---
// Home. Same flow as Vault Human: hero → our approach (the Whole Picture wheel) → meet Russ (video)
// → where to start → three steps → in their own words → plans → questions → begin.
// Rules: short, clean copy; tiles, never hyphen lists; every button pair the same size;
// stills from the videos are not reused as photos.
import Base from '../layouts/Base.astro';
import VideoSlot from '../components/VideoSlot.astro';
import Plans from '../components/Plans.astro';
import WholePicture from '../components/WholePicture.astro';
import Voices from '../components/Voices.astro';
import { cta, faqs, trustPriceNote, pricesEffectiveThrough } from '../data/site.js';
const homeFaqs = faqs.filter((f) => ['will-or-trust', 'probate', 'homestead', 'bring'].includes(f.id));
const video = { src: '/video/russ/russ-welcome.mp4', captions: '/video/russ/russ-welcome.vtt', poster: '/video/russ/russ-still.jpg' };
---
<Base
  title="Tercet Law | Estate Planning for Texas Families"
  description="Wills, trusts and one complete plan for everything you've built, with attorney Russ Michaels. A flat fee set before we begin."
  path="/"
  inner={false}
>
  <section class="hero"><img class="bgimg" src="/video/home.jpg" width="1280" height="720" style="object-position:50% 35%" alt="A mother, father and young child walking hand in hand through a park in autumn" fetchpriority="high" /><video class="bgimg bgvid" autoplay muted loop playsinline preload="auto" poster="/video/home.jpg" aria-hidden="true"><source src="/video/home.mp4" type="video/mp4" /></video><div class="veil"></div><div class="wrap">
    <div class="hero-copy">
      <div class="timeword"><span class="tw past">Past</span><span class="tw present">Present</span><span class="tw future on">Future</span></div>
      <h1>Estate planning <em>for Texas families.</em></h1>
      <p class="lede">Protect the people you love and everything you&rsquo;ve built. One complete plan, with a flat fee set before we begin.</p>
      <div class="ctarow eq"><a class="btn btn-line" href={cta.href}>{cta.label}</a><button class="btn btn-acc" type="button" data-vslot={video.src} data-vslot-captions={video.captions} data-vslot-poster={video.poster}>Meet Russ</button></div>
    </div>
  </div></section>

  <section class="sec dark" id="approach"><div class="wrap">
    <div class="sec-head"><p class="eyebrow">Our approach</p><h2>Your whole picture. One plan.</h2><p class="lede">Eight parts of a life, each with its own keys. Some families need one piece. Most need all of it to connect, so what you built, what you have now and who comes next are held together.</p></div>
    <WholePicture />
    <div class="ctarow eq" style="margin-top:38px"><a class="btn btn-ghost" href={cta.href}>{cta.label}</a><a class="btn btn-acc" href="/services">All services</a></div>
  </div></section>

  <div id="watch"><VideoSlot title="Meet Russ Michaels" src={video.src} captions={video.captions} poster={video.poster} eyebrow="Your attorney" heading="Meet Russ." lede="Why he does this work, and what a plan does for the people you love.">
    <div class="ctarow eq"><a class="btn btn-line" href={cta.href}>{cta.label}</a><a class="btn btn-acc" href="/about">About Russ</a></div>
  </VideoSlot></div>

  <section class="sec alt" id="start"><div class="wrap">
    <div class="sec-head"><p class="eyebrow">Where to start</p><h2>Start where your life is.</h2></div>
    <div class="pcards">
      <a class="pcard" href="/services#estate-planning"><img src="/images/home-family-newborn.jpg" alt="A family gathered around a mother holding her newborn" style="object-position:66% 35%" loading="lazy" /><span class="pc-k">Planning ahead</span><b>A plan for your family</b><em>Wills, trusts and the people in charge.</em></a>
      <a class="pcard" href="/services#elder-law"><img src="/images/process-couple-video-call.jpg" alt="An older couple smiling together at a laptop on their sofa" style="object-position:55% 35%" loading="lazy" /><span class="pc-k">Caring for someone</span><b>The years ahead</b><em>Powers of attorney and a plan for aging.</em></a>
      <a class="pcard" href="/services#probate"><img src="/images/pricing-couple-sofa.jpg" alt="An older couple going over papers together at home" style="object-position:50% 35%" loading="lazy" /><span class="pc-k">After a loss</span><b>Settling an estate</b><em>Probate and trusts in Texas, step by step.</em></a>
    </div>
  </div></section>

  <section class="sec" id="how"><div class="wrap">
    <div class="sec-head"><p class="eyebrow">How it works</p><h2>Three steps.</h2></div>
    <div class="tiles3">
      <div class="tile"><img src="/images/start-couple-laptop.jpg" alt="A couple smiling at a laptop together" style="object-position:50% 30%" loading="lazy" /><div class="tile__b"><span class="tile__n">01</span><h3>Map</h3><p>Forty-five minutes with Russ. Your whole picture, on one page.</p></div></div>
      <div class="tile"><img src="/images/faq-library-shelves.jpg" alt="Rows of bound law books on library shelves" loading="lazy" /><div class="tile__b"><span class="tile__n">02</span><h3>Design</h3><p>The plan that fits, for a flat fee set in writing before any work begins.</p></div></div>
      <div class="tile"><img src="/images/about-couple-signing.jpg" alt="A couple signing a document together at a table" style="object-position:40% 40%" loading="lazy" /><div class="tile__b"><span class="tile__n">03</span><h3>Sign</h3><p>You sign, and Russ makes sure every account and deed matches the plan.</p></div></div>
    </div>
    <div class="ctarow eq" style="margin-top:30px"><a class="btn btn-line" href={cta.href}>{cta.label}</a><a class="btn btn-acc" href="/process">See the process</a></div>
  </div></section>

  <section class="hq"><div class="wrap"><p>A good plan isn&rsquo;t about the end. It&rsquo;s about the people you love knowing exactly what you wanted.</p></div></section>

  <Voices />

  <section class="sec alt" id="pricing"><div class="wrap">
    <div class="sec-head"><p class="eyebrow">Plans</p><h2>Flat fees. Clear coverage.</h2><p class="lede">Each plan shows which parts of your picture it covers. Anything else is quoted flat after your session.</p></div>
    <Plans detail={false} />
    <p class="offers-note">{trustPriceNote} Prices effective through {pricesEffectiveThrough}. <a href="/pricing">What each plan includes</a>.</p>
  </div></section>

  <section class="sec" id="faq"><div class="wrap">
    <div class="sec-head"><p class="eyebrow">Questions</p><h2>Straight answers.</h2></div>
    <div class="faq">{homeFaqs.map((f) => (<details><summary>{f.q}</summary>{f.a.map((p) => <p>{p}</p>)}</details>))}</div>
    <p class="offers-note">General information, not legal advice. <a href="/faq">More questions</a>.</p>
  </div></section>

  <section class="sec final" id="begin"><img class="bgimg" src="/images/about-pennybacker-bridge.jpg" width="1800" height="1200" style="object-position:50% 55%" alt="The Pennybacker Bridge over Lake Austin at sunset" loading="lazy" /><div class="veil"></div><div class="wrap">
    <h2>There&rsquo;s a door here for you.</h2><p class="lede">Let&rsquo;s put on paper what you&rsquo;ve been putting off.</p>
    <div class="ctarow eq"><a class="btn btn-line" href={cta.href}>{cta.label}</a><button class="btn btn-acc" type="button" data-vslot={video.src} data-vslot-captions={video.captions} data-vslot-poster={video.poster}>Meet Russ</button></div>
  </div></section>

  <style is:inline>
    .ctarow.eq .btn{min-width:300px;text-align:center;justify-content:center}
    @media(max-width:560px){.ctarow.eq .btn{min-width:0;width:100%}}
    .tiles3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
    .tile{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column}
    .tile img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block}
    .tile__b{padding:24px 24px 26px;border-top:3px solid var(--acc)}
    .tile__n{font-family:var(--disp);font-size:44px;line-height:.9;color:var(--acc)}
    .tile h3{font-family:var(--disp);font-weight:400;font-size:34px;line-height:1;margin:6px 0 10px}
    .tile p{margin:0;color:var(--muted);font-size:17px;line-height:1.5}
    .hq{background:var(--bg2);padding:56px 0;text-align:center;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .hq p{font-family:var(--disp);font-size:clamp(24px,2.4vw,32px);line-height:1.15;color:var(--acc-ink);max-width:34ch;margin:0 auto}
    .wcards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
    .wcard{display:flex;flex-direction:column;gap:10px;background:#fff;border:1px solid var(--line);border-top:3px solid var(--acc);border-radius:12px;padding:26px;text-decoration:none;color:var(--ink);transition:box-shadow .3s,border-color .3s}
    .wcard:hover{box-shadow:0 10px 30px rgba(31,58,95,.14)}
    .wcard.key{border-top-color:#C98B5A}
    .wcard__k{font-size:11px;letter-spacing:3px;text-transform:uppercase;font-weight:700;color:var(--acc)}
    .wcard.key .wcard__k{color:#A86F42}
    .wcard b{font-family:var(--disp);font-weight:400;font-size:32px;line-height:1}
    .wcard em{font-style:normal;color:var(--muted);font-size:16px;line-height:1.5}
    @media(max-width:900px){.tiles3,.wcards{grid-template-columns:1fr}.tiles3{gap:12px}
      .tile{flex-direction:row;align-items:stretch}
      .tile img{width:34%;max-width:150px;aspect-ratio:auto;height:auto;min-height:100%;flex:0 0 auto}
      .tile__b{padding:14px 16px 16px;border-top:0;border-left:3px solid var(--acc);flex:1}
      .tile__n{font-size:28px}.tile h3{font-size:26px;margin:2px 0 6px}.tile p{font-size:15px;line-height:1.45}}
  </style>
</Base>
