  /* faq */
  .faq{padding:58px 0}
  .faq-list{max-width:800px;margin:34px auto 0}
  details{border-bottom:1px solid var(--line);padding:18px 4px}
  summary{font-family:'Fraunces';font-size:1.12rem;font-weight:500;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:20px;align-items:center}
  summary::-webkit-details-marker{display:none}
  summary::after{content:"+";color:var(--brass);font-size:1.5rem;font-family:'Inter'}
  details[open] summary::after{content:"–"}
  details p{color:var(--ink-soft);margin-top:12px;font-size:.96rem}

  /* final cta */
  .final{background:linear-gradient(160deg,var(--forest) 0%,var(--forest-deep) 100%);color:var(--ivory);padding:60px 0}
  .final h2{color:var(--white);margin-bottom:10px}
