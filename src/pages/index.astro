  .final .prices span{font-size:.78rem;color:#BFCabb}
  form{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:8px;padding:28px}
  form label{display:block;font-size:.8rem;letter-spacing:.04em;margin-bottom:6px;color:#DDE5DC}
  form input,form select,form textarea{width:100%;padding:12px 14px;margin-bottom:16px;border-radius:3px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.95);font-family:inherit;font-size:.95rem}
  form .btn-primary{background:var(--brass);width:100%;border:none}
  form .btn-primary:hover{background:#946f2f}
  .disclaimer{font-size:.72rem;color:#AEB8AC;margin-top:12px;line-height:1.5}
  @media(max-width:820px){.final-grid{grid-template-columns:1fr;gap:32px}}

  /* footer */
  footer{background:var(--ink);color:#B7B2A6;padding:52px 0 30px;font-size:.86rem}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:36px;margin-bottom:34px}
  footer .brand{color:var(--ivory);margin-bottom:12px}
  footer a{color:#B7B2A6}footer a:hover{color:var(--ivory)}
  footer h5{color:var(--ivory);font-family:'Inter';font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;margin-bottom:14px}
  footer ul{list-style:none;display:flex;flex-direction:column;gap:9px}
  .endorse{font-family:'Fraunces';font-style:italic;color:#8FA394}
  .legal{border-top:1px solid rgba(255,255,255,.1);padding-top:22px;font-size:.74rem;color:#8A857A;line-height:1.6}
  @media(max-width:720px){.foot-grid{grid-template-columns:1fr;gap:26px}}
.portrait-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 12%}
.navlinks a.btn{color:var(--ivory)}
</style>
