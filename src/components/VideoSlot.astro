---
// A place for one of Russ's videos. It plays right here, in place, with captions (no pop-up).
// Until a page's own video is finished, it shows Russ's welcome video (swap `src` later).
// Clean on purpose: a still and a play button, no titles or running times over the picture.
interface Props {
  title: string;          // used only for the screen-reader label
  src?: string;
  captions?: string;
  poster?: string;
  eyebrow?: string;
  heading?: string;
  lede?: string;
  dark?: boolean;
  tall?: boolean;          // vertical 9:16 video (Legal Keys)
}
const WELCOME = { src: '/video/russ/russ-welcome.mp4', captions: '/video/russ/russ-welcome.vtt', poster: '/video/russ/russ-still.jpg' };
const { title, src = WELCOME.src, captions = src === WELCOME.src ? WELCOME.captions : '', poster = WELCOME.poster, eyebrow = '', heading, lede, dark = false, tall = false } = Astro.props;
---
<section class:list={['sec', 'vslot-sec', { dark, tall }]}><div class="wrap vslot-grid">
  <div class="vslot-copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{heading ?? title}</h2>
    {lede && <p class="lede">{lede}</p>}
  </div>
  <div class="vslot" data-vslot-box data-src={src} data-captions={captions} data-poster={poster}>
    <img src={poster} alt="" loading="lazy" />
    <button class="vslot__play" type="button" aria-label={`Play video: ${title}`}><span aria-hidden="true"></span></button>
  </div>
  {Astro.slots.has('default') && <div class="vslot-btns"><slot /></div>}
</div></section>
