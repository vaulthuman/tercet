---
import Base from '../../layouts/Base.astro';
import { writing } from '../../data/writing.js';
import { cta } from '../../data/site.js';
export function getStaticPaths() {
  return writing.map((p, i) => ({ params: { slug: p.slug }, props: { p, newer: writing[i - 1] || null, older: writing[i + 1] || null } }));
}
const { p, newer, older } = Astro.props;
const kicker = p.type === 'key' ? `Legal Key No. ${p.keyNo}` : 'Writing';
const schema = [{ "@context": "https://schema.org", "@type": "Article", headline: p.title, description: p.dek, datePublished: p.iso, author: { "@type": "Person", name: "Russ Michaels" }, publisher: { "@type": "LegalService", name: "Tercet Law" } }];
---
<Base title={`${p.title} | Tercet Law`} description={p.dek} path={`/writing/${p.slug}/`} schema={schema}>
  <article class="sec wp"><div class="wrap wp__in">
    <p class="wp__k"><a href="/writing/">Writing</a> · {kicker} · {p.date}</p>
    <h1>{p.title}</h1>
    <p class="wp__dek">{p.dek}</p>
  </div></article>
  <article class="sec wp wp--body"><div class:list={['wrap', 'wp__in', { 'wp__in--reel': p.reel }]}>
    {p.reel && <div class="vslot vslot--reel" data-vslot-box data-src={p.reel.src} data-captions="" data-poster={p.reel.poster}><img src={p.reel.poster} alt="" loading="lazy" /><button class="vslot__play" type="button" aria-label={`Play video: ${p.reel.title}`}><span aria-hidden="true"></span></button></div>}
    <div class="wp__body">{p.body.map((t) => <p>{t}</p>)}</div>
    <p class="wp__fine">General information about Texas law, not legal advice. Every family is different.</p>
    <div class="ctarow wp__cta"><a class="btn btn-line" href={cta.href}>{cta.label}</a><a class="btn btn-acc" href="/writing/">All writing</a></div>
    <nav class="wp__nav">{older ? <a href={`/writing/${older.slug}/`}>&larr; {older.title}</a> : <span></span>}{newer ? <a href={`/writing/${newer.slug}/`}>{newer.title} &rarr;</a> : <span></span>}</nav>
  </div></article>
  <style is:inline>
    .wp__in{max-width:760px}
    .wp__in--reel{max-width:1040px;display:grid;grid-template-columns:minmax(0,1fr) 320px;column-gap:56px;align-items:start}
    .wp__in--reel>*{grid-column:1}
    .wp__in--reel .vslot--reel{grid-column:2;grid-row:1 / span 6;position:sticky;top:100px;aspect-ratio:9/16;width:100%}
    .vslot--reel img{object-position:50% 50%}
    @media(max-width:900px){.wp__in--reel{grid-template-columns:1fr}.wp__in--reel .vslot--reel{grid-column:1;grid-row:auto;position:relative;top:0;max-width:340px;margin:0 auto 28px}}
    .wp:has(+ .vslot-sec) .wp__dek{border-bottom:0;margin-bottom:0;padding-bottom:0}
    .wp--body{padding-top:48px}
    .wp__k{font-size:12px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;color:var(--acc);margin:0 0 18px}
    .wp__k a{color:inherit}
    .wp h1{font-size:clamp(44px,5vw,72px);line-height:.95;margin:0 0 18px}
    .wp__dek{font-size:21px;line-height:1.5;color:var(--muted);margin:0 0 34px;padding-bottom:28px;border-bottom:1px solid var(--line)}
    .wp__body p{font-size:19px;line-height:1.7;margin:0 0 22px}
    .wp__fine{font-size:14px;color:var(--muted);margin:30px 0 0}
    .wp__cta{margin-top:28px}
    .wp__nav{display:flex;justify-content:space-between;gap:20px;margin-top:44px;padding-top:24px;border-top:1px solid var(--line);font-size:15px}
    .wp__nav a{color:var(--acc);text-decoration:none;max-width:48%}
  </style>
</Base>
