---
// Shared frame for every Tercet Law page: head (meta, Ads tag + lead listener, structured data),
// header, footer, booking modal and page scripts. Content and settings live in src/data/site.js.
import '../styles/family.css';
import '../styles/tokens.css';
import '../styles/tercet.css';
import { firm, cta, plans, priceRange, RESPONSIBLE_ATTORNEY } from '../data/site.js';

const {
  title = "Tercet Law | Flat-Fee Estate Planning in Austin, Texas",
  description = "Flat-fee wills, trusts and powers of attorney for Austin families and business owners. Book a free 45-minute Estate Map Session on Zoom.",
  path = "/",
  inner = true,
  modal = true,
  sticky = true,
  image = "https://www.tercetlaw.com/og-tercet-texas.png",
  schema = [],
} = Astro.props;

const canonical = new URL(path, firm.url).href;
const year = new Date().getFullYear();

const offers = plans.flatMap((p) => {
  if (p.amountCouple) {
    return [
      { "@type": "Offer", name: `${p.name} (one person)`, price: String(p.amount), priceCurrency: "USD" },
      { "@type": "Offer", name: `${p.name} (couple)`, price: String(p.amountCouple), priceCurrency: "USD" },
    ];
  }
  if (p.from) {
    return [{ "@type": "Offer", name: p.name, priceCurrency: "USD", priceSpecification: { "@type": "PriceSpecification", minPrice: p.amount, priceCurrency: "USD" } }];
  }
  return [{ "@type": "Offer", name: p.name, price: String(p.amount), priceCurrency: "USD" }];
});

const person = {
  "@type": "Person",
  "@id": `${firm.url}/#russ`,
  name: firm.attorney,
  jobTitle: "Attorney",
  worksFor: { "@id": `${firm.url}/#firm` },
  sameAs: [firm.linkedin],
};
if (RESPONSIBLE_ATTORNEY !== firm.attorney) person.alternateName = RESPONSIBLE_ATTORNEY;

const firmSchema = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "@id": `${firm.url}/#firm`,
  name: firm.name,
  legalName: firm.legalName,
  url: firm.url,
  telephone: firm.phoneSchema,
  email: firm.email,
  image: "https://www.tercetlaw.com/og-tercet-texas.png",
  description: "Flat-fee estate planning for Austin, Texas families and business owners: wills, revocable living trusts, powers of attorney and Texas deeds. Every plan handled personally by the attorney. Free 45-minute Estate Map Session on Zoom.",
  address: { "@type": "PostalAddress", addressLocality: "Austin", addressRegion: "TX", addressCountry: "US" },
  areaServed: [
    { "@type": "City", name: "Austin", containedInPlace: { "@type": "State", name: "Texas" } },
    { "@type": "AdministrativeArea", name: "Travis County, Texas" },
    { "@type": "State", name: "Texas" },
  ],
  knowsAbout: ["Estate planning", "Wills", "Revocable living trusts", "Powers of attorney", "Texas probate", "Texas homestead"],
  priceRange,
  founder: person,
  hasOfferCatalog: { "@type": "OfferCatalog", name: "Flat-fee estate plans", itemListElement: offers },
};
const ld = [firmSchema, ...schema];
---
<!doctype html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <meta name="description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="Tercet Law" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={image} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:url" content={canonical} /><meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={image} />
  <meta name="geo.region" content="US-TX" /><meta name="geo.placename" content="Austin" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- Google Ads gtag (AW-18371546487) + HubSpot conversion listener -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script>
    window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};var gtag=window.gtag;
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD',{linker:{domains:['vaulthuman.com','tercetlaw.com']}});
    (function(){var fired=false;function fire(){if(fired)return;fired=true;gtag('event','conversion',{send_to:'AW-18371546487/yVNiCKX9xqkdEPeanrhE'});gtag('event','generate_lead');}
    window.addEventListener('message',function(e){var d=e&&e.data;if(!d)return;if(typeof d==='string'){try{d=JSON.parse(d);}catch(_){return;}}if(!d||typeof d!=='object')return;var t=d.type||d.messageType||'',n=d.eventName||d.event||'';if(t==='hsFormCallback'&&(n==='onFormSubmitted'||n==='onFormSubmit'))fire();else if(n==='onFormSubmitted')fire();else if(d.accepted===true&&d.formGuid)fire();});
    window.addEventListener('hsFormCallback',function(e){if(e&&e.detail&&e.detail.eventName==='onFormSubmitted')fire();});})();
  </script>
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body data-time="future" class={inner ? 'inner' : undefined}>
  <header class="site"><div class="wrap bar">
    <a class="brand" href="/">Tercet <b>Law</b></a>
    <nav class="navlinks" id="navlinks"><a href="/pricing">Plans &amp; Pricing</a><a href="/process">How It Works</a><a href="/faq">Texas FAQ</a><a href="/about">About Russ</a><a class="btn btn-acc" href={cta.href}>{cta.label}</a></nav><button class="navtoggle" type="button" aria-label="Open menu" aria-controls="navlinks" aria-expanded="false"><span></span><span></span><span></span></button>
  </div></header>

  <main><slot /></main>

  <footer class="site">
    <div class="wrap foot">
      <div><a class="brand" href="/">Tercet <b>Law</b></a><p>Flat-fee estate planning for Austin families and business owners.</p><p><a href={`mailto:${firm.email}`}>{firm.email}</a> · <a href={firm.phoneHref}>{firm.phone}</a></p></div>
      <ul><li><a href="/pricing">Plans &amp; Pricing</a></li><li><a href="/process">How It Works</a></li><li><a href="/faq">Texas FAQ</a></li><li><a href="/about">About Russ</a></li><li><a href={cta.href}>{cta.label}</a></li></ul>
      <ul><li><a href="/disclaimers">Disclaimers</a></li><li><a href="/privacy/">Privacy</a></li><li><a href={firm.linkedin} target="_blank" rel="noopener">LinkedIn</a></li><li><a href="https://www.vaulthuman.com">Vault Human</a> — daily coaching</li></ul>
    </div>
    <div class="wrap legal"><span class="resp">{firm.legalName} · {firm.city}, {firm.state} · Responsible attorney: {RESPONSIBLE_ATTORNEY}</span><span>Attorney advertising</span></div>
    <div class="wrap legal-fine">&copy; {year} {firm.legalName}. {firm.license}. This website is general information, not legal advice. No attorney-client relationship forms until an engagement letter is signed. <a href="/disclaimers">Disclaimers</a> · <a href="/privacy/">Privacy</a> · Part of the Vault Human family.</div>
  </footer>

  {modal && (
  <div id="vh-modal" class="vh-modal" aria-hidden="true">
    <div class="vh-modal__bg" data-close-form></div>
    <div class="vh-modal__card" role="dialog" aria-modal="true" aria-label="Book your Estate Map Session">
      <button class="vh-modal__x" type="button" data-close-form aria-label="Close">&times;</button>
      <h2 class="vh-modal__title">Book your Estate Map Session</h2><p class="vh-modal__sub">Free, 45 minutes, on Zoom. Pick a time that suits you and you'll get a calendar invite with the link.</p>
      <div class="calendly-inline-widget" data-url="https://calendly.com/vaulthuman/tercet-planning-call?hide_gdpr_banner=1&hide_landing_page_details=1" style="min-width:300px;height:640px;border-radius:10px;overflow:hidden;background:#fff"></div><p style="margin:12px 0 0;font-size:14px;opacity:.8;text-align:center">Rather talk now? <a href="tel:+18888332510">(888) 833-2510</a></p><script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script><style is:inline>.vh-modal__card{width:min(820px,94vw)!important}</style>
    </div>
  </div>
  )}
  <script is:inline src="https://js-na2.hsforms.net/forms/embed/246947446.js" defer></script>
  <script is:inline>
  (function(){var m=document.getElementById('vh-modal');if(!m)return;
  function o(e){if(e)e.preventDefault();m.classList.add('is-open');m.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';}
  function c(){m.classList.remove('is-open');m.setAttribute('aria-hidden','true');document.documentElement.style.overflow='';}
  document.addEventListener('click',function(e){var t=e.target.closest('[data-open-form]');if(t){o(e);return;}if(e.target.closest('[data-close-form]'))c();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')c();});
  if(location.hash==='#start')o();})();
  addEventListener('DOMContentLoaded',function(){
   document.body.classList.add('ready');
   if(!('IntersectionObserver'in window))return;
   var e=[].slice.call(document.querySelectorAll('.sec .wrap > *, .split__copy > *'));e.forEach(function(x){x.classList.add('reveal')});
   var o=new IntersectionObserver(function(t){t.forEach(function(y){if(y.isIntersecting){y.target.classList.add('in');o.unobserve(y.target)}})},{threshold:0.08,rootMargin:'0px 0px -30px 0px'});
   e.forEach(function(x){o.observe(x)});
  });
  </script>
  {sticky && (<div class="stickybar" id="stickybar"><span>Free · 45 min</span><a class="btn btn-acc" href={cta.href}>{cta.label}</a></div>)}
  <script is:inline>
  (function(){var sb=document.getElementById('stickybar');if(sb){document.body.classList.add('has-sticky');setTimeout(function(){sb.classList.add('on')},6000);}})();
  </script>
  <script is:inline>(function(){var b=document.querySelector(".navtoggle"),n=document.getElementById("navlinks");if(!b||!n)return;function set(o){document.body.classList.toggle("nav-open",o);b.setAttribute("aria-expanded",o?"true":"false");b.setAttribute("aria-label",o?"Close menu":"Open menu");}b.addEventListener("click",function(){set(!document.body.classList.contains("nav-open"));});n.addEventListener("click",function(e){if(e.target.closest("a"))set(false);});document.addEventListener("keydown",function(e){if(e.key==="Escape")set(false);});})();</script>
  <script is:inline>(function(){var h=document.querySelector("header.site");function f(){if(h)h.classList.toggle("scrolled",scrollY>40)}addEventListener("scroll",f,{passive:true});f();})();</script>
</body>
</html>
