---
// Legal Keys: every key in one place, numbered 001, 002, 003… (three a week, about 156 a year).
// Keys dated after today stay hidden in the browser until their day. Ties the keys to Vault Human at the end.
import Base from '../layouts/Base.astro';
import { writing, legalKeyDays, keyLabel } from '../data/writing.js';
import { cta } from '../data/site.js';
const keys = writing.filter((p) => p.type === 'key').sort((a, b) => b.keyNo - a.keyNo);
const desc = `Legal Keys from Tercet Law: one short, clear key to Texas estate planning every ${legalKeyDays}. Each one opens a part of your whole picture.`;
---
<Base title="Legal Keys | Tercet Law" description={desc} path="/legal-keys/">
  <section class="pagehero"><img class="bgimg" src="/images/tint-river.jpg" width="1600" height="900" style="object-position:50% 50%" alt="A clear Texas Hill Country river running over smooth stones" fetchpriority="high" /><div class="veil"></div><div class="wrap">
    <p class="eyebrow">Legal Keys</p><h1>One key <em>at a time.</em></h1><p class="lede">Every {legalKeyDays}, one short key to a part of your plan. Each one opens a door. Together, they add up to the whole picture.</p><div class="ctarow" style="margin-top:28px"><a class="btn btn-line" href="#keys">See the keys</a><a class="btn btn-acc" href={cta.href}>{cta.label}</a></div>
  </div></section>

  <section class="lk-count"><div class="wrap lk-count__row">
    <div><b data-keycount>{keys.length}</b><span>keys so far</span></div>
    <div><b>3</b><span>a week</span></div>
    <div><b>156</b><span>in a year</span></div>
    <div><b>8</b><span>parts of your whole picture</span></div>
  </div></section>

  <section class="sec lk" id="keys"><div class="wrap">
    <div class="lk-grid">{keys.map((k) => {
      const thumb = k.reel ? k.reel.poster : k.img;
      return (
        <a class={`lk-card${k.reel ? ' has-reel' : ''}`} href={`/writing/${k.slug}/`} data-iso={k.iso}>
          {thumb && <span class="lk-card__img"><img src={thumb} alt="" loading="lazy" />{k.reel && <i aria-hidden="true"></i>}</span>}
          <span class="lk-card__b">
            <span class="lk-card__n">{String(k.keyNo).padStart(3, '0')}</span>
            <span class="lk-card__k">{keyLabel(k.keyNo)} · {k.date}</span>
            <b>{k.title}</b>
            <em>{k.dek.replace(/^Legal Key \d+\.\s*/, '')}</em>
            <span class="lk-card__go">{k.reel ? 'Watch and read' : 'Read the key'} &rarr;</span>
          </span>
        </a>
      );
    })}</div>
  </div></section>

  <section class="sec lk-vh"><div class="wrap lk-vh__in">
    <p class="eyebrow">Beyond the law</p>
    <h2>Keys for the rest of life.</h2>
    <p class="lede">The idea behind these keys runs deeper than the law. Kindness keeps families out of court. Fairness is a conversation. Small, honest steps, taken one at a time, change how a family looks at things. Russ also leads Vault Human, a daily coaching practice built the same way: one key, every morning and evening, for the whole of you.</p>
    <div class="ctarow" style="margin-top:26px"><a class="btn btn-line" href="https://www.vaulthuman.com/" target="_blank" rel="noopener">Visit Vault Human</a><a class="btn btn-acc" href="/writing/">All writing</a></div>
    <p class="lk-fine">Vault Human is a separate coaching company. It is not a law firm and does not give legal advice. Legal Keys are general information about Texas law, not legal advice.</p>
  </div></section>

  <script is:inline>
    (function(){var t=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Chicago',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
      document.querySelectorAll('.lk-card[data-iso]').forEach(function(el){if(el.getAttribute('data-iso')>t)el.remove()});
      var c=document.querySelector('[data-keycount]');if(c)c.textContent=document.querySelectorAll('.lk-card').length;})();
  </script>
  <style is:inline>
    .lk-count{background:var(--dark);color:#fff;padding:26px 0}
    .lk-count__row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;text-align:center}
    .lk-count b{display:block;font-family:var(--disp);font-weight:400;font-size:46px;line-height:1;color:#C98B5A}
    .lk-count span{font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:rgba(255,255,255,.78)}
    .lk{position:relative;isolation:isolate;background:#F1E7D8}
    .lk:before{content:"";position:absolute;inset:0;background:url('/images/tint-windmill.jpg') center/cover;opacity:.1;z-index:-1}
    .lk-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
    .lk-card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-top:3px solid #C98B5A;border-radius:12px;overflow:hidden;text-decoration:none;color:var(--ink);box-shadow:0 10px 28px rgba(31,26,21,.08);transition:box-shadow .3s,transform .3s}
    .lk-card:hover{box-shadow:0 16px 40px rgba(31,58,95,.16);transform:translateY(-2px)}
    .lk-card__img{position:relative;display:block;aspect-ratio:4/3;overflow:hidden;background:var(--dark)}
    .lk-card__img img{width:100%;height:100%;object-fit:cover;display:block}
    .lk-card.has-reel .lk-card__img img{object-position:50% 40%}
    .lk-card__img i{position:absolute;right:12px;bottom:12px;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.94)}
    .lk-card__img i:after{content:"";position:absolute;left:15px;top:11px;border-style:solid;border-width:9px 0 9px 14px;border-color:transparent transparent transparent var(--acc)}
    .lk-card__b{position:relative;display:flex;flex-direction:column;gap:8px;padding:20px 22px 22px;flex:1}
    .lk-card__n{position:absolute;left:18px;top:-48px;font-family:var(--disp);font-size:54px;line-height:1;color:#fff;text-shadow:0 2px 14px rgba(0,0,0,.45)}
    .lk-card__k{font-size:11px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;color:#A86F42}
    .lk-card b{font-family:var(--disp);font-weight:400;font-size:30px;line-height:1;text-wrap:balance}
    .lk-card em{font-style:normal;color:var(--muted);font-size:15.5px;line-height:1.5}
    .lk-card__go{margin-top:auto;padding-top:8px;color:var(--acc);font-weight:600;font-size:14.5px}
    .lk-vh{position:relative;isolation:isolate;background:var(--dark);color:#fff;text-align:center}
    .lk-vh:before{content:"";position:absolute;inset:0;background:url('/images/tint-river.jpg') center/cover;opacity:.18;z-index:-1}
    .lk-vh__in{max-width:820px}
    .lk-vh h2{color:#fff;margin:10px auto 16px;max-width:22ch}
    .lk-vh .lede{color:rgba(255,255,255,.86);margin:0 auto}
    .lk-vh .ctarow{justify-content:center}
    .lk-fine{font-size:13px;color:rgba(255,255,255,.6);margin:22px auto 0;max-width:60ch}
    @media(max-width:980px){.lk-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:640px){.lk-grid{grid-template-columns:1fr}.lk-count__row{grid-template-columns:repeat(2,minmax(0,1fr))}.lk-count b{font-size:38px}}
  </style>
</Base>
