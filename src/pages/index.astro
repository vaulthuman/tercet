---
import Base from '../layouts/Base.astro';
import { firm, hero, pillars, turn, whyTercet, closing } from '../data/site.js';
---
<Base>
  <div class="wrap">
    <section class="hero">
      <p class="kicker">{firm.kicker}</p>
      <h1>{hero.h1}</h1>
      <p class="subline">{hero.subline}</p>
    </section>
    <div class="lede">{hero.lede.map((p) => <p>{p}</p>)}</div>
    <div class="cta"><a class="btn-fill" href="/start">{hero.cta}</a></div>

    <hr class="rule" />
    <section class="cols">{pillars.map((c) => (<div><h3>{c.title}</h3><p>{c.body}</p></div>))}</section>

    <hr class="rule" />
    <p class="turn">{turn}</p>

    <hr class="rule" />
    <h2 class="sec">Why Tercet</h2>
    <div class="lede">{whyTercet.map((p) => <p set:html={p} />)}</div>

    <hr class="rule" />
    <h2 class="sec">Explore</h2>
    <section class="cols">
      <div><h3><a href="/services" class="fam-ish">Services</a></h3><p>Estate planning, trusts, probate, powers of attorney, elder law, and more.</p></div>
      <div><h3><a href="/pricing" class="fam-ish">Pricing</a></h3><p>Three flat-fee plans, quoted before any work begins.</p></div>
      <div><h3><a href="/process" class="fam-ish">Process</a></h3><p>Four unhurried steps, from first conversation to a plan that holds.</p></div>
    </section>

    <hr class="rule" />
    <p class="closing">{closing}</p>
    <div class="ctarow" id="start"><a class="btn-fill" href="/start">Start with a conversation</a><a class="btn-line" href={`mailto:${firm.email}`}>Email the firm</a></div>
  </div>
</Base>
