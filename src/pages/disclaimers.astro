---
import Base from '../layouts/Base.astro';
import { firm, RESPONSIBLE_ATTORNEY } from '../data/site.js';
const alias = RESPONSIBLE_ATTORNEY !== firm.attorney ? ` ("${firm.attorney}")` : '';
---
<Base
  title="Disclaimers | Tercet Law"
  description="Attorney advertising and website disclaimers for Tercet Law, PLLC, Austin, Texas."
  path="/disclaimers/"
>
    <section class="pagehero plain"><div class="wrap">
      <p class="eyebrow">Legal</p><h1>Disclaimers.</h1><p class="lede">Attorney advertising, licensing and the limits of this website.</p>
    </div></section>
    <section class="sec" id="legal"><div class="wrap legal-prose">
      <h3>Attorney advertising</h3><p>This website is attorney advertising. {firm.legalName} is based in {firm.city}, {firm.state}. {RESPONSIBLE_ATTORNEY}{alias} is the attorney responsible for this website and is licensed to practice law in Texas{firm.barNumber ? ` (State Bar of Texas No. ${firm.barNumber})` : ''}. He is not certified by the Texas Board of Legal Specialization. No representation is made that the quality of the legal services to be performed is greater than the quality of legal services performed by other lawyers.</p>
      <h3>No legal advice; no attorney-client relationship</h3><p>This website is offered for general information only and is not legal advice. Reading it, booking an Estate Map Session, or sending a message through it does not create an attorney-client relationship. An attorney-client relationship begins only upon a signed engagement letter. Please do not send confidential information until an engagement is in place.</p>
      <h3>Fees</h3><p>Fees are flat and confirmed in writing before any work begins. Fees shown as "from" are starting prices; the exact fee is quoted after the Estate Map Session. Court costs, recording fees and third-party charges are separate and disclosed in advance.</p>
      <h3>Timing and results</h3><p>Timelines on this site are typical, not guaranteed. Every estate and every family is different. Nothing on this site is a guarantee of any outcome.</p>
      <h3>Vault Human</h3><p>Tercet Law is a member of the Vault Human family of companies. Vault Human coaching is separate from legal services, is not legal advice, and is never required to engage Tercet Law.</p>
    </div></section>
</Base>
