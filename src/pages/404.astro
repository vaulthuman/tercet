---
import Base from '../layouts/Base.astro';
import { cta } from '../data/site.js';
---
<Base
  title="Page not found | Tercet Law"
  description="That page has moved. Start here."
  path="/"
  inner={false}
>
    <section class="sec"><div class="wrap" style="text-align:center;max-width:760px;margin:0 auto;padding:130px 20px 110px">
      <p class="eyebrow">Page not found</p>
      <h1 style="margin:10px 0 14px">That page has moved.</h1>
      <p class="lede" style="margin:0 auto 28px">Everything is a click away from here: flat-fee estate planning for Austin families.</p>
      <div class="ctarow" style="justify-content:center"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href="/">Go to the home page</a></div>
    </div></section>
</Base>
