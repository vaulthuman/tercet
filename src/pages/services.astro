---
// Practice areas. Content lives in src/data/site.js (services). Fees: estate planning uses the four plans;
// everything else is a flat fee quoted after the free Estate Map Session. No prices here.
import Base from '../layouts/Base.astro';
import VideoSlot from '../components/VideoSlot.astro';
import { firm, cta, guideCta, services, servicesFeeNote, steps } from '../data/site.js';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Tercet Law services",
  itemListElement: services.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: { "@type": "Service", name: s.title, description: `${s.short}. For ${s.for.charAt(0).toLowerCase() + s.for.slice(1)}`, provider: { "@id": `${firm.url}/#firm` }, areaServed: "Texas" },
  })),
};
const svcAlt: Record<string, string> = {
  'estate-planning': 'Grandparents cooking with their grandchildren in the kitchen',
  'probate': 'A family sitting close together, comforting one another after a loss',
  'trust-administration': 'Two women reviewing documents together at a table',
  'elder-law': 'A daughter holding her elderly father\'s hand as they sit together',
  'special-needs': 'A family together outdoors with their daughter in her wheelchair',
  'business-succession': 'Two shop owners in aprons smiling in their store',
  'real-estate': 'A mother and her daughters sitting on the front steps of their home',
  'digital-life': 'A young woman showing her grandfather something on a smartphone',
};
---
<Base
  title="Services | Tercet Law, Austin, Texas"
  description="Estate planning, probate and estate administration, trust administration, elder law and incapacity planning, special needs planning, business succession, Texas deeds, and your digital life and likeness. Flat fees in writing."
  path="/services/"
  schema={[serviceSchema]}
>
    <section class="pagehero"><img class="bgimg" src="/video/services.jpg" width="1280" height="720" style="object-position:50% 15%" alt="An older couple going over papers with their attorney" fetchpriority="high" /><video class="bgimg bgvid" autoplay muted loop playsinline preload="auto" poster="/video/services.jpg" style="object-position:50% 15%" aria-hidden="true"><source src="/video/services.mp4" type="video/mp4" /></video><div class="veil"></div><div class="wrap">
      <p class="eyebrow">Services</p><h1>Everything your plan <em>touches.</em></h1><p class="lede">Planning ahead, caring for someone who needs help, or settling an estate after a loss. One attorney, one complete plan, and a flat fee in writing before any work begins.</p><div class="ctarow" style="margin-top:28px"><a class="btn btn-line" href={cta.href}>{cta.label}</a><a class="btn btn-acc" href={guideCta.href}>{guideCta.label}</a></div>
    </div></section>

    <VideoSlot title="Protect your kids" src="/video/russ/protecting-your-kids.mp4" captions="/video/russ/protecting-your-kids.vtt" poster="/video/russ/protecting-your-kids-poster.jpg" heading="Protect your kids." lede="Who raises them, and who handles the money, if you can't." />


    <section class="sec tint" id="areas" style="--tint:url(/images/tint-savanna.jpg);--tint-o:.07;background:#F3ECE1"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">The whole picture</p><h2>Eight ways we help.</h2><p class="lede">Each one is a part of <a href="/#approach">your whole picture</a>, with its own keys. Not sure which you need? That is what the free session is for.</p></div>
      <div class="svc-detail">{services.map((s) => (
        <article class="svcd" id={s.id}>
          <img class="svcd__img" src={`/images/svc-${s.id}.jpg`} width="1200" height="750" alt={svcAlt[s.id] ?? ''} loading="lazy" />
          <h3>{s.title}</h3>
          <p class="svcd__short">{s.short}</p>
          <p class="svcd__k">Who it is for</p><p>{s.for}</p>
          <p class="svcd__k">The keys</p>
          <ul>{s.includes.map((i) => <li>{i}</li>)}</ul>
          <p class="svcd__fee">{s.fee === 'plans' ? <span>Four flat-fee plans, or one built to suit. <a href="/pricing">See pricing</a>.</span> : <span>{servicesFeeNote}.</span>}{s.id === 'probate' && <span> <a href="/probate/">How probate works in Austin</a>.</span>}</p>
        </article>
      ))}<div class="svcd svcd--cta"><div class="svcd--cta__t"><h3>Not sure which?</h3><p class="svcd__short">Many families need more than one. That is normal.</p><p>In a free 45-minute Estate Map Session on Zoom, Russ maps what you have and what you want, and tells you which of these fits and its flat fee. No pressure either way.</p></div><a class="btn btn-acc" href={cta.href}>{cta.label}</a></div></div>
      <p class="faq-note">Every matter is different. What a matter includes is confirmed in your engagement letter, with the fee, before any work begins. Court costs, recording fees and other third-party charges are separate and disclosed in advance. {firm.license}.</p>
    </div></section>

    <section class="sec alt tint" id="how" style="--tint:url(/images/tint-bluebonnet.jpg);--tint-o:.14"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">The same three steps</p><h2>Whatever brings you here.</h2></div>
      <div class="steps">{steps.map((s) => (<div class="step"><div class="n">{s.n}</div><h3>{s.title}</h3><p>{s.body}</p></div>))}</div>
      <p class="offers-note">For probate and trust administration, the steps are the same idea: map what there is, design the path, then carry it out with you. <a href="/process">See the process</a>.</p>
    </div></section>

    <section class="split alt"><div class="split__media" style="background-image:url('/images/services-grandfather-baby.jpg');background-position:40% 30%" role="img" aria-label="A grandfather holding his smiling baby grandson as the grandmother and the baby&rsquo;s father look on"></div><div class="split__copy">
      <p class="eyebrow">Every generation</p><h2>One plan for the whole family.</h2>
      <p class="split__lede">Parents, grandparents and the children who count on them. A good plan looks after each of them, and makes sure the people you trust know what to do.</p>
      <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a></div>
    </div></section>

    <section class="sec final plain" id="begin"><div class="wrap">
      <h2>Talk it through first.</h2><p class="lede">A free 45-minute Estate Map Session on Zoom. You leave knowing what you need, and the flat fee to do it.</p>
      <div class="ctarow"><a class="btn btn-line" href={cta.href}>{cta.label}</a><a class="btn btn-acc" href={firm.phoneHref}>{firm.phone}</a></div>
    </div></section>
</Base>
