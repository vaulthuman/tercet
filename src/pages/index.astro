  /* hero */
  .hero{padding:46px 0 44px}
  .hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:44px;align-items:center}
  .hero h1{margin-bottom:14px}
  .hero .lede{font-size:1.15rem;color:var(--ink-soft);max-width:33ch;margin-bottom:14px}
  .hero .price-note{font-size:.92rem;color:var(--forest);font-weight:600;margin-bottom:18px}
  .hero-cta{display:flex;gap:14px;flex-wrap:wrap}
  .hero-trust{margin-top:26px;font-size:.82rem;color:var(--ink-soft);display:flex;gap:18px;flex-wrap:wrap;align-items:center}
  .hero-trust span{display:flex;align-items:center;gap:7px}
  .dot{width:5px;height:5px;border-radius:50%;background:var(--brass);display:inline-block}
  /* portrait placeholder */
  .portrait{aspect-ratio:4/4.9;max-width:315px;margin-left:auto;border-radius:4px;background:
     linear-gradient(160deg,var(--forest) 0%,var(--forest-deep) 100%);
     position:relative;overflow:hidden;display:flex;align-items:flex-end;box-shadow:0 24px 60px -28px rgba(22,49,39,.6)}
