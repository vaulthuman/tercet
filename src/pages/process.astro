---
import Base from '../layouts/Base.astro';
import EstateMap from '../components/EstateMap.astro';
import { firm, cta, guideCta, steps, timingNote, story } from '../data/site.js';
---
<Base
  title="How It Works | Tercet Law, Austin Estate Planning"
  description="Map, design, sign and fund: the three steps of a Tercet Law estate plan, from a free 45-minute Estate Map Session on Zoom to a signed plan in about three weeks."
  path="/process/"
>
    <section class="pagehero photo-right"><img class="bgimg" src="/images/process-video-call.jpg" width="1800" height="1200" style="object-position:45% 45%" alt="An older couple at home on a video call at a laptop" fetchpriority="high" /><div class="veil"></div><div class="wrap">
      <p class="eyebrow">How it works</p><h1>Map. Design. <em>Sign &amp; Fund.</em></h1><p class="lede">Three simple steps from your first conversation to a signed plan, in about three weeks from the day you engage. Clear at every step, and never rushed.</p><div class="ctarow" style="margin-top:28px"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href={firm.phoneHref}>{firm.phone}</a></div>
    </div></section>

    <section class="sec" id="steps"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Three steps</p><h2>What happens, in order.</h2></div>
      <div class="steps">{steps.map((s) => (<div class="step"><div class="n">{s.n}</div><p class="when">{s.when}</p><h3>{s.title}</h3><p>{s.body}</p></div>))}</div>
      <ul class="promises">{story.promises.map((p) => <li>{p}</li>)}</ul>
      <p class="offers-note">{timingNote}</p>
    </div></section>

    <section class="sec alt" id="map"><div class="wrap mapgrid">
      <div>
        <p class="eyebrow">Step one, up close</p>
        <h2>Your Estate Map Session.</h2>
        <ul class="ticks">
          <li>Free, 45 minutes, on Zoom. Nothing to send ahead of time.</li>
          <li>Russ maps what you own and how each piece would pass today: by will, by deed, by beneficiary form or by trust.</li>
          <li>You see who would be in charge if something happened, and where the gaps are.</li>
          <li>You leave with a recommendation and its flat fee. You decide, with no pressure.</li>
        </ul>
        <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a></div>
      </div>
      <EstateMap />
    </div></section>

    <section class="split rev" id="bring"><div class="split__media" style="background-image:url('/images/process-grandparents.jpg');background-position:45% 40%" role="img" aria-label="Grandparents reading a page together with their two grandchildren at the kitchen table"></div><div class="split__copy">
      <p class="eyebrow">What to bring</p><h2>A rough picture, not a mountain of paperwork.</h2>
      <ul class="ticks"><li>Who is in your life: spouse, children, parents, anyone you provide for.</li><li>What you own, roughly: home, bank and investment accounts, retirement accounts, life insurance, any business.</li><li>Who you would trust to act for you, and who should inherit.</li><li>Any existing wills, trusts or powers of attorney, so nothing gets drafted twice.</li></ul>
      <div class="ctarow"><a class="btn btn-acc" href={guideCta.href}>{guideCta.label}</a><a class="btn btn-line" href="/faq">Texas FAQ</a></div>
    </div></section>

    <section class="sec" id="after"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">What changes</p><h2>When it is done.</h2></div>
      <div class="after"><div><b>Your wishes are in writing.</b><p>Who decides, who inherits, and where everything is.</p></div><div><b>Your family knows who decides.</b><p>The people you chose, with the documents to act.</p></div><div><b>Your plan has a guide.</b><p>One attorney who already knows it, when life changes.</p></div></div>
    </div></section>

    <section class="sec final plain" id="begin"><div class="wrap">
      <h2>Start with the map.</h2><p class="lede">Forty-five minutes on Zoom, free, with no obligation.</p>
      <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href={firm.phoneHref}>{firm.phone}</a></div>
    </div></section>
</Base>
