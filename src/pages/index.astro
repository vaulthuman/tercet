---
// Home, built on the StoryBrand (SB7) frame: the client is the hero, Tercet Law is the guide.
// Hero → problem and stakes → guide (empathy + authority) → three-step plan → services → plans →
// what a plan protects (success) → free checklist (transitional CTA) → FAQ → final call to action.
import Base from '../layouts/Base.astro';
import Plans from '../components/Plans.astro';
import EstateMap from '../components/EstateMap.astro';
import Tercet from '../components/Tercet.astro';
import { firm, cta, guideCta, steps, timingNote, faqs, trustPriceNote, story, services, servicesFeeNote } from '../data/site.js';
const homeFaqs = faqs.filter((f) => ['will-or-trust', 'probate', 'homestead', 'bring'].includes(f.id));
---
<Base
  title="Tercet Law | Estate, Trust & Legacy Planning in Austin, Texas"
  description="Estate, trust and legacy planning for Austin and Texas families, plus probate, trust administration and elder law. Three simple steps and a flat fee in writing, handled personally by attorney Russ Michaels. Book a free 45-minute Estate Map Session on Zoom."
  path="/"
  inner={false}
>
    <section class="hero hero-split"><div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="timeword"><span class="tw past">Past</span><span class="tw present">Present</span><span class="tw future on">Future</span></div>
        <h1>Estate, trust and legacy planning <em>for Austin families.</em></h1>
        <p class="lede">Wills, living trusts and a plan for everything you&rsquo;ve built, with probate and elder law when your family needs them. Three clear steps and a flat fee in writing, so the people you love know exactly what you want and what to do.</p>
        <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href={guideCta.href}>{guideCta.label}</a></div>
        <p class="guarantee">Free · 45 minutes · on Zoom · {firm.license}</p>
      </div>
      <figure class="hero-photo"><img src="/images/home-family-advisor-table.jpg" width="1600" height="1068" style="object-position:50% 40%" alt="An advisor with a clipboard talking with a father, mother and their young daughter around a dining table at home" fetchpriority="high" /></figure>
    </div></section>

    <section class="split" id="problem"><div class="split__media" style="background-image:url('/images/home-family-newborn.jpg');background-position:70% 30%" role="img" aria-label="Three generations of a family smiling around a newborn baby held by his mother, grandparents at either side"></div><div class="split__copy">
      <p class="eyebrow">Why plan now</p><h2>Without a plan, Texas law makes the choices.</h2>
      <p class="split__lede">You know you should have a plan. It just feels complicated, uncomfortable and hard to start. Meanwhile, without one:</p>
      <ul class="ticks">{story.failure.map((f) => <li>{f}</li>)}</ul>
      <p class="split__lede"><b>{story.problem.philosophical}</b></p>
      <div class="ctarow"><a class="btn btn-line" href="/faq">Read the Texas FAQ</a></div>
    </div></section>

    <section class="sec dark" id="guide"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Your guide</p><h2>We understand. And we keep it simple.</h2><p class="lede">{story.empathy} {firm.attorney} handles every matter personally, explains every page in plain English and sets the fee in writing first.</p></div>
      <div class="facts dark3">{story.authority.map((a) => <div><b>{a.k}</b><span>{a.d}</span></div>)}</div>
      <blockquote class="guide-quote">A good plan is not about the end. It is about the people you love knowing exactly what you intended.<cite>{firm.attorney}</cite></blockquote>
      <div class="ctarow"><a class="btn btn-ghost" href="/about">About Russ</a><a class="btn btn-acc" href={cta.href}>{cta.label}</a></div>
    </div></section>

    <section class="sec" id="how"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">The plan</p><h2>Three simple steps.</h2><p class="lede">Map. Design. Sign &amp; Fund. A signed plan in about three weeks from the day you engage.</p></div>
      <div class="steps">{steps.map((s) => (<div class="step"><div class="n">{s.n}</div><p class="when">{s.when}</p><h3>{s.title}</h3><p>{s.body}</p></div>))}</div>
      <ul class="promises">{story.promises.map((p) => <li>{p}</li>)}</ul>
      <p class="offers-note">{timingNote}</p>
      <div class="ctarow" style="margin-top:22px"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href="/process">See the process</a></div>
    </div></section>

    <section class="sec alt" id="map"><div class="wrap mapgrid">
      <div>
        <p class="eyebrow">Step one, up close</p>
        <h2>See your whole estate on one screen.</h2>
        <ul class="ticks">
          <li>Forty-five minutes on Zoom with {firm.attorney}, free.</li>
          <li>Russ builds a visual map as you talk: what you own, who depends on you, and who you trust to take charge.</li>
          <li>You see how each piece would pass today, and where the gaps are.</li>
          <li>You leave knowing what fits and its flat fee. No pressure either way.</li>
        </ul>
        <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a></div>
      </div>
      <EstateMap />
    </div></section>

    <section class="sec" id="services"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">What we do</p><h2>More than a will.</h2><p class="lede">Planning ahead, caring for someone who needs help, or settling an estate after a loss: one attorney, in plain English, with a flat fee in writing.</p></div>
      <div class="svc-grid">{services.map((s) => (
        <a class="svc" href={`/services#${s.id}`}><b>{s.title}</b><span class="svc__short">{s.short}</span><span class="svc__for">{s.for}</span><span class="svc__more">Learn more</span></a>
      ))}<a class="svc svc--cta" href={cta.href}><b>Not sure which?</b><span class="svc__short">Start with the map.</span><span class="svc__for">Forty-five minutes on Zoom, free. You leave knowing what you need and its flat fee.</span><span class="svc__more">Book your session</span></a></div>
      <p class="offers-note">Estate planning is offered as four flat-fee plans, below. Every other matter is a {servicesFeeNote.charAt(0).toLowerCase() + servicesFeeNote.slice(1)}. <a href="/services">All services</a>.</p>
    </div></section>

    <section class="sec alt" id="pricing"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Estate planning plans</p><h2>Four plans. Flat fees.</h2><p class="lede">Your fee is set in writing before any work begins. No hourly billing on your plan.</p></div>
      <Plans detail={false} />
      <p class="offers-note">{trustPriceNote} Legacy is quoted in writing after your Estate Map Session. <a href="/pricing">See everything each plan includes</a>.</p>
    </div></section>

    <Tercet variant="protects" />

    <section class="checkband" id="checklist"><div class="wrap checkband__in">
      <div><p class="eyebrow">Not ready to book?</p><h2>Start with the free Texas checklist.</h2><p>One page: the people, the property and the papers to gather before you plan. Print it, fill it in at the kitchen table, and bring it to your session when you are ready.</p></div>
      <div class="ctarow"><a class="btn btn-acc" href={guideCta.href}>{guideCta.label}</a></div>
    </div></section>

    <section class="sec alt" id="faq"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Texas questions</p><h2>Straight answers.</h2></div>
      <div class="faq">{homeFaqs.map((f) => (<details><summary>{f.q}</summary>{f.a.map((p) => <p>{p}</p>)}</details>))}</div>
      <p class="offers-note">General information, not legal advice. <a href="/faq">More Texas questions</a>.</p>
    </div></section>

    <section class="sec final" id="begin"><img class="bgimg" src="/images/home-hands-generations.jpg" width="1800" height="1200" style="object-position:55% 60%" alt="Hands of a grandmother, a mother and a young girl clasped together in a family's laps" loading="lazy" /><div class="veil"></div><div class="wrap">
      <h2>Your wishes, clear. Your family, ready.</h2><p class="lede">{story.success.join(' ')} It starts with forty-five minutes on Zoom, free.</p>
      <div class="ctarow"><a class="btn btn-acc" href={cta.href}>{cta.label}</a><a class="btn btn-line" href={firm.phoneHref}>{firm.phone}</a></div>
    </div></section>
</Base>
